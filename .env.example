# === Broker (Binance) ===
BINANCE_API_KEY=
BINANCE_API_SECRET=

# === LLM Providers ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Runtime ===
# Set to "1" ONLY after API-key approval and full paper-trading validation.
LIVE_TRADING=0
# Daily loss limit (base currency) that halts trading for the day.
MAX_DAILY_LOSS=500
# Max concurrent open positions (units of base asset, e.g. BTC).
MAX_POSITION=0.001
# Probability threshold for model signal gating.
PROB_THRESHOLD=0.85
# Ring buffer tick capacity.
RING_BUFFER_SIZE=300
# Symbols the engine trades (comma-separated base asset pairs).
CRYPTO_SYMBOLS="BTCUSDT,ETHUSDT"
